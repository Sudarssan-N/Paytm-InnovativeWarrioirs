# AI provider keys. These are read by the API server only (server/aiProxy.mjs)
# and are never bundled into the web app. The older VITE_SARVAM_API_KEY /
# VITE_DEEPSEEK_API_KEY names are still accepted.
# Sarvam (https://dashboard.sarvam.ai): Bulbul v3 TTS, Saaras v3 STT, Mayura translation.
SARVAM_API_KEY=
# DeepSeek: thinks through open questions and writes grounded answers.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional dial-in and call-back (server/telephony.mjs). PUBLIC_HOST is the tunnel
# or deployment host name, with no scheme, for example abc123.ngrok-free.app.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
PUBLIC_HOST=

# Optional. The onboarding call (server/agentCall.mjs, docs/VOICE_AGENT.md): a Sarvam
# voice agent rings the customer. All of these come from the Voice Agents dashboard.
# With PUBLIC_HOST set, results arrive by webhook. Without it, the server polls Sarvam.
SARVAM_AGENT_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_AGENT_APP_ID=
SARVAM_AGENT_APP_VERSION=
SARVAM_CONNECTION_ID=
SARVAM_AGENT_NUMBER=
# Optional. A Sarvam agent made for RM follow-ups, used by "Call customer" on the RM desk.
# Without it the desk uses the onboarding agent above. It receives rm_name, case_id,
# case_reason, customer_question and next_step as well.
SARVAM_RM_APP_ID=
SARVAM_RM_APP_VERSION=

# Optional. What production would set.
# MITRA_ROUTER=deepseek           # Route on DeepSeek. The default is Sarvam-105B Conversations
# MITRA_CACHE_KEY=                # Encrypts the voice cache at rest
# MITRA_CACHE_DAYS=30             # Voice cache lifetime
# MITRA_RETENTION_DAYS=30         # Journeys older than this are removed
# MITRA_DESK_TOKEN=               # Staff token for the expert desk
# MITRA_TRUST_PROXY=1             # Believe x-forwarded-for. Only behind your own proxy
# MITRA_LOG=json                  # One JSON line per request, path only
# PAYTM_MCP_URL=                  # Defaults to Paytm's hosted MCP server
# PAYTM_PULL_MONTHS=6             # Full months of Paytm records read for the business profile
